# Local development — use this on your Windows PC
# For Docker/VPS, see comments at the bottom.

DESKTRACK_ENV=development
SECRET_KEY=desk-track-local-dev
AGENT_TOKEN=desk-local
PUBLIC_URL=http://127.0.0.1:8000
HOST=127.0.0.1
PORT=8000
HTTPS_ONLY=false
SEED_DEMO=false
RELOAD=true
TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_URL=sqlite:///office.db

# --- Docker / VPS only (do NOT use these paths on Windows) ---
# DESKTRACK_ENV=production
# SECRET_KEY=<openssl rand -hex 32>
# AGENT_TOKEN=<openssl rand -hex 16>
# PUBLIC_URL=http://YOUR_VPS_IP:8000
# HOST=0.0.0.0
# HTTPS_ONLY=false
# SEED_DEMO=false
# RELOAD=false
# CORS_ORIGINS=http://YOUR_VPS_IP:8000
# DATABASE_URL=sqlite:////app/data/office.db
